<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context="ar.edu.unicen.seminario.feature.filters.presentation.FiltersFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Seminario.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="@dimen/elevacion_card"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/filtros" />

        <!-- Estado de carga -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margen_grande"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />

        <!-- Estado de error -->
        <include
            android:id="@+id/error_layout"
            layout="@layout/layout_error_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Contenido principal -->
        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_mediano"
            android:visibility="gone">

            <!-- Sección de Ordenamiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_normal"
                android:text="@string/ordenar_por"
                android:textAppearance="@style/TextAppearance.Seminario.Titulo" />

            <Spinner
                android:id="@+id/spinner_ordering"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_boton"
                android:layout_marginBottom="@dimen/margen_grande" />

            <!-- Sección de Plataformas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_normal"
                android:text="@string/seleccionar_plataforma"
                android:textAppearance="@style/TextAppearance.Seminario.Titulo" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_platforms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_grande"
                android:maxHeight="200dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter_checkbox" />

            <!-- Sección de Géneros -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_normal"
                android:text="@string/seleccionar_genero"
                android:textAppearance="@style/TextAppearance.Seminario.Titulo" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_grande"
                android:maxHeight="200dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter_checkbox" />

            <!-- Sección de Publishers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_normal"
                android:text="@string/seleccionar_publisher"
                android:textAppearance="@style/TextAppearance.Seminario.Titulo" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_publishers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_grande"
                android:maxHeight="200dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter_checkbox" />

            <!-- Sección de Tiendas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_normal"
                android:text="@string/seleccionar_store"
                android:textAppearance="@style/TextAppearance.Seminario.Titulo" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_grande"
                android:maxHeight="200dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter_checkbox" />

            <!-- Botones de acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_mediano"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_clear_filters"
                    style="@style/Widget.Seminario.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margen_normal"
                    android:layout_weight="1"
                    android:text="@string/limpiar_filtros" />

                <Button
                    android:id="@+id/btn_apply_filters"
                    style="@style/Widget.Seminario.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/aplicar_filtros" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
