<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de backup para versiones anteriores a Android 12
   Ver https://developer.android.com/guide/topics/data/autobackup
   para más detalles.
-->
<full-backup-content>
    <!-- Incluir preferencias compartidas de la aplicación -->
    <include domain="sharedpref" path="." />

    <!-- Incluir base de datos de la aplicación -->
    <include domain="database" path="." />

    <!-- Excluir archivos temporales y caché -->
    <exclude domain="cache" path="." />
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="logs/" />

    <!-- Excluir imágenes descargadas-->
    <exclude domain="file" path="images/" />
    <exclude domain="file" path="image_cache/" />

    <!-- Excluir configuraciones específicas del dispositivo -->
    <exclude domain="sharedpref" path="device_config.xml" />
</full-backup-content>