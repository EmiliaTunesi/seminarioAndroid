<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_large">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="@dimen/loading_indicator_size"
        android:layout_height="@dimen/loading_indicator_size"
        android:layout_marginBottom="@dimen/margin_small"
        android:contentDescription="@string/content_description_loading" />

    <TextView
        android:id="@+id/tvLoadingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/loading_data"
        android:textAppearance="@style/TextAppearance.Core.Body"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_small"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Core.Body"
        android:textColor="@color/error"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetry"
        style="@style/Widget.Core.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/retry"
        android:visibility="gone" />

</LinearLayout>
